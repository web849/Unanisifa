# ============================================================================
# ইউনানী সিফা (Unani Sifa) — Environment Variables
# ----------------------------------------------------------------------------
# এই ফাইলটি শুধু নমুনা। আসল মান বসবে Vercel (Production + Preview) এবং
# Neon ড্যাশবোর্ডে। .env কখনো Git-এ কমিট করবেন না।
# যেসব ভেরিয়েবল সেট নেই, সেসব ফিচার অ্যাডমিনে "Pending — কারণ: …" দেখাবে,
# কখনো ভুয়া সাকসেস দেখাবে না।
# ============================================================================

# ---- ডেটাবেজ (Neon Postgres) ------------------------------------------------
# Neon → Connection Details → "Pooled connection" (PgBouncer, port 5432)
# অ্যাপ্লিকেশন এই স্ট্রিং ব্যবহার করে। না দিলে পাবলিক ক্যাটালগ লোকাল ডেমো
# ডেটা দিয়ে রেন্ডার হবে, কিন্তু কোনো রাইট/অর্ডার/অ্যাডমিন লগিন কাজ করবে না।
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-south-1.aws.neon.tech/unanisifa?sslmode=require"

# Neon → "Direct connection" (non-pooled) — শুধু মাইগ্রেশনের জন্য
# (scripts/migrate.mjs ও drizzle-kit এই স্ট্রিং ব্যবহার করে)
DIRECT_URL="postgresql://user:password@ep-xxxx.ap-south-1.aws.neon.tech/unanisifa?sslmode=require"

# ---- অথ ও সিকিউরিটি ---------------------------------------------------------
# JWT সাইনিং সিক্রেট — কমপক্ষে ৩২ অক্ষর। তৈরি করতে:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# IP হ্যাশ করার সিক্রেট (ফ্রড ডিটেকশনে IP হ্যাশ সেভ হয়, প্লেইন IP নয় —
# তবে অ্যাডমিন রিভিউয়ের জন্য আলাদা কলামে শেষ অংশ রাখা হয়)
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=""

# /api/cron/* রুট প্রটেক্ট করার সিক্রেট। Vercel Cron এই হেডার পাঠায়:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ---- সাইট -------------------------------------------------------------------
# পাবলিক সাইট URL (canonical, sitemap, OG, ওয়েবহুক লিংকে ব্যবহৃত হয়)
NEXT_PUBLIC_SITE_URL="https://unanisifa.com"

# ---- ডিপ্লয় / মাইগ্রেশন -----------------------------------------------------
# Vercel Preview বিল্ডে ডেটাবেজ মাইগ্রেশন চালাতে "1" দিন — শুধু তখনই, যখন
# Preview-তে প্রোডাকশন থেকে আলাদা Neon ব্রাঞ্চ/ডেটাবেজ ব্যবহার করছেন।
# খালি/অসেট থাকলে Preview কখনো প্রোডাকশন স্কিমা বদলাবে না (নিরাপদ ডিফল্ট)।
ALLOW_PREVIEW_DB_MIGRATIONS=""

# ---- মিডিয়া স্টোরেজ (Cloudflare R2) — ঐচ্ছিক --------------------------------
# চারটিই সেট না থাকলে আপলোড বন্ধ থাকবে; অ্যাডমিনে "URL পেস্ট করুন" চালু থাকবে।
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# পাবলিক কাস্টম ডোমেইন, যেমন https://cdn.unanisifa.com (অথবা bucket-এর r2.dev URL)
R2_PUBLIC_BASE_URL=""

# ---- Telegram নোটিফিকেশন — ঐচ্ছিক -------------------------------------------
# @BotFather থেকে টোকেন এবং আপনার গ্রুপ/চ্যানেলের chat id।
# সেট না থাকলে Admin → Notifications-এ "Pending" দেখাবে।
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---- Resend ইমেইল — ঐচ্ছিক ---------------------------------------------------
# https://resend.com → API Keys। verified sender ডোমেইন লাগবে।
# সেট না থাকলে ইমেইল পাঠানো হবে না, কিউ-তে "skipped" লগ থাকবে।
RESEND_API_KEY=""
# পাঠকের নাম ও ইমেইল (ডিফল্ট: ইউনানী সিফা / support@unanisifa.com)
RESEND_FROM_NAME=""
RESEND_FROM_EMAIL=""
# অ্যাডমিন অ্যালার্ট ইমেইল (ডিফল্ট: ADMIN_EMAIL)
ALERT_EMAIL=""

# ---- Meta Pixel + Conversions API — ঐচ্ছিক -----------------------------------
# Pixel ID (Events Manager) ও CAPI access token।
# সেট না থাকলে Tracking সম্পূর্ণ বন্ধ, Admin → Integrations-এ "Pending"।
META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=""

# ---- প্রথম অ্যাডমিন সিড (একবারের জন্য) ----------------------------------------
# `npm run db:bootstrap-admin` এই মান দিয়ে owner অ্যাকাউন্ট তৈরি করে।
# পাসওয়ার্ড ভুলে গেলে ADMIN_EMAIL ও নতুন ADMIN_PASSWORD GitHub Actions secrets-এ
# সেট করে db-migrate workflow-এর "Reset existing admin password" চালান।
# কাজ শেষে ADMIN_PASSWORD secret মুছে ফেলুন; এখানে স্থায়ীভাবে রাখবেন না।
ADMIN_EMAIL="owner@unanisifa.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Owner"
