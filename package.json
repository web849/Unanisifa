{
  "name": "unanisifa",
  "version": "1.0.0",
  "private": true,
  "description": "ইউনানী সিফা (Unani Sifa) — ইউনানী ও ভেষজ ওষুধের মোবাইল-ফার্স্ট ই-কমার্স প্ল্যাটফর্ম",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test \"tests/unit/*.test.ts\"",
    "qa": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:seed-catalog": "node scripts/seed-catalog.mjs",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "cleanup:demo": "node scripts/cleanup-demo.mjs",
    "db:studio": "drizzle-kit studio",
    "predeploy": "npm run db:migrate",
    "assets:demo": "node scripts/generate-demo-assets.mjs"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "typescript": "^5.9.3"
  }
}